# Postgres connection string. Get one free from Neon (https://neon.tech) or
# Vercel Postgres, then copy this file to `.env` and paste it in.
#
# Neon: use the *pooled* connection string (the host contains "-pooler") so
# serverless invocations don't exhaust connections.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/sayyes?sslmode=require"

# Resend SMTP password (Resend dashboard -> API Keys; the key doubles as the
# SMTP password). Host/port/user are fixed: smtp.resend.com:465, user "resend".
SMTP_PASSWORD="re_xxxxxxxx"

# Optional. From-address for the notification emails; must be on a domain
# verified in your Resend account. Defaults to noreply@sayyes.fun if unset.
# MAIL_FROM="SayYes <noreply@yourdomain.com>"
