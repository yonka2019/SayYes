# Postgres connection string. Get one free from Neon (https://neon.tech) or
# Vercel Postgres, then copy this file to `.env` and paste it in.
#
# Neon: use the *pooled* connection string (the host contains "-pooler") so
# serverless invocations don't exhaust connections.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/sayyes?sslmode=require"
