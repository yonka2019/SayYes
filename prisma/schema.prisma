generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Mascot {
  BEAR
  PENGUIN
}

enum Status {
  PENDING
  ANSWERED
}

model Invitation {
  id            String     @id @default(cuid())
  recipientName String
  mascot        Mascot
  gateQuestion  String
  /// The language the creator authored in. The recipient's chrome follows it.
  locale        String     @default("he")
  status        Status     @default(PENDING)
  createdAt     DateTime   @default(now())
  answeredAt    DateTime?
  questions     Question[]
  answers       Answer[]
}

model Question {
  id           String           @id @default(cuid())
  invitationId String
  order        Int
  text         String
  invitation   Invitation       @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  options      QuestionOption[]
  answers      Answer[]

  @@index([invitationId])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  label      String
  order      Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    Answer[]

  @@index([questionId])
}

model Answer {
  id               String         @id @default(cuid())
  invitationId     String
  questionId       String
  selectedOptionId String
  createdAt        DateTime       @default(now())
  invitation       Invitation     @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  question         Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   QuestionOption @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  @@unique([invitationId, questionId])
  @@index([invitationId])
}
